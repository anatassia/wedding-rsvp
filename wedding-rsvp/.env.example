# Backend only — never exposed to the frontend bundle.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-service-role-secret-key
# Comma-separated Supabase Auth user UUIDs allowed to use the organiser dashboard.
ADMIN_USER_IDS=11111111-1111-1111-1111-111111111111,22222222-2222-2222-2222-222222222222

# Frontend (Vite inlines these at build time) — safe to expose, used only
# for organiser sign-in via Supabase Auth. Never put the secret key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# Optional. Falls back to a generic Google Maps search for "Kunang Sungai
# Petani" if left blank — set this once you have the venue's exact pin.
VITE_GOOGLE_MAPS_URL=https://maps.app.goo.gl/62F9r68RGD8QDdXa7

# Optional. Leave blank to keep the music control present-but-disabled —
# only point this at a licensed audio file you have the rights to use.
VITE_WEDDING_AUDIO_URL=
